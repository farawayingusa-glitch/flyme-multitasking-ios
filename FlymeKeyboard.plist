<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <!--
                 UIKit is the smallest available static injection scope that
                 UIKit remains the system keyboard-host entry point. WeChat
                 is explicit so its main process receives the app-side
                 responder-dismiss adapter at process startup; Keyboard.xm
                 still applies the exact shared bundle-hash gate before any
                 functional route work.
            -->
            <string>com.apple.UIKit</string>
            <string>com.tencent.xin</string>
        </array>
    </dict>
</dict>
</plist>
